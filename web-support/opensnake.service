# systemd service for the OpenSnake server (website, accounts, records, versus).
#
# Set up for a repository cloned to /opt/opensnake with its .venv created as
# described in web-support/README.md, and an opensnake system user to run it.
# If yours is elsewhere, change the paths below (WorkingDirectory,
# ExecStartPre, ExecStart and ReadWritePaths).
#
# Install:
#   useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin opensnake
#   cp web-support/opensnake.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now opensnake
#
# Build the web game before starting it, and again after each update
# (the build needs internet; the service only runs the server):
#   PYTHON=.venv/bin/python web-support/build.sh

[Unit]
Description=OpenSnake server (website, accounts, records, versus)
After=network-online.target
Wants=network-online.target
# Keep retrying if the address isn't up yet at boot (the bind fails until it is).
StartLimitIntervalSec=0

[Service]
Type=simple
User=opensnake
Group=opensnake
WorkingDirectory=/opt/opensnake
# Create the data folder first ("+" runs this as root outside the sandbox below,
# which needs the folder to exist and makes everything else read-only).
# The opensnake user owns only this folder; the code stays root's.
ExecStartPre=+/usr/bin/install -d -o opensnake -g opensnake /opt/opensnake/web-support/data
# Listens on every address. Use 127.0.0.1 instead for a proxy on this same
# machine.
ExecStart=/opt/opensnake/.venv/bin/python -m opensnake.server --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
# Show output in `journalctl -u opensnake` straight away.
Environment=PYTHONUNBUFFERED=1

# Sandboxing: the server only needs to write its own data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/opensnake/web-support/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
